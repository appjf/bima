{
  "entities": {
    "PrasaranaPriceConfig": {
      "title": "Prasarana Price Configuration",
      "description": "Configuration for infrastructure unit prices (HSpbg)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "The label of the infrastructure" },
        "label": { "type": "string", "description": "The label of the infrastructure" },
        "unit": { "type": "string", "description": "Unit of measurement" },
        "price": { "type": "number", "description": "Unit price (HSpbg)" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" }
      },
      "required": ["id", "label", "unit", "price"]
    }
  },
  "firestore": {
    "/settings/prasarana_prices": {
      "schema": "PrasaranaPriceConfig",
      "description": "Collection of infrastructure price configurations"
    }
  }
}
